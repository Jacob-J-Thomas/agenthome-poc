<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepositoryRelativeProjectDirectory>$([System.IO.Path]::GetRelativePath('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</RepositoryRelativeProjectDirectory>
    <IsTestProjectLocation>$([System.String]::Copy('$(RepositoryRelativeProjectDirectory)/').StartsWith('tests/'))</IsTestProjectLocation>
    <!-- Shipped production contracts emit XML documentation; test assemblies are intentionally outside this API-documentation gate. -->
    <GenerateDocumentationFile Condition="'$(IsTestProjectLocation)' != 'True'">true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
