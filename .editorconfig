root = true

[*.cs]
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

dotnet_naming_rule.private_fields_use_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_use_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_use_underscore_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Parameter casing is enforced by the syntax-aware CSharpParameterNamingTests gate because EditorConfig groups positional-record properties with ordinary parameters.

dotnet_naming_rule.public_types_use_pascal_case.severity = warning
dotnet_naming_rule.public_types_use_pascal_case.symbols = public_types
dotnet_naming_rule.public_types_use_pascal_case.style = pascal_case
dotnet_naming_symbols.public_types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.public_types.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Project preference: keep method calls and argument lists on one line when readable.
# Standard .editorconfig cannot fully express the "wrap only after more than 3 arguments" rule.
