        <mxCell id="init" value="init [root]&lt;br&gt;Read-only freshness + marker + exact-role preflight&lt;br&gt;Partial/damaged/concurrent .agent fails closed without backfill&lt;br&gt;Scaffold ROLE.md; fresh only persists default-assistant revision 1&lt;br&gt;Re-prove exact active role immediately before marker publication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="350" y="225" width="300" height="135" as="geometry" />
        </mxCell>
