      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="embodysense-custom-loop-mvp" name="Custom Loop MVP">
    <mxGraphModel dx="2200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />
        <mxCell id="c-title" value="EmbodySense current implementation: Web governed-graph authoring + canonical runtime" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="25" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c-subtitle" value="The authenticated Web surface authors exact immutable governed graphs from the server catalog, projects their durable frontier, and controls schedules, deliveries, wakes, and runs only through shared Startup facades. Layout and browser state never become runtime truth." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4A5568" vertex="1" parent="c1">
          <mxGeometry x="50" y="70" width="1500" height="32" as="geometry" />
        </mxCell>

        <mxCell id="c-authoring-label" value="AUTHORING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#6B46C1" vertex="1" parent="c1">
          <mxGeometry x="50" y="115" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c-web" value="Web shared-shell Loops view&lt;br&gt;Local Builder + Runs tabs; /loops.html redirects here&lt;br&gt;Governed graph authoring reads the server profile catalog/default, supports exact or inherited graph routing and Inference overrides, retains ordered fallback intent, expands graph/node ceilings without granting authority, and shows current non-granting eligibility plus exact profile/configuration pins and privacy posture&lt;br&gt;Run inspection projects authenticated per-attempt, node-series, run, unknown, and outstanding-reservation usage evidence&lt;br&gt;Default conversation remains a separate read-only Startup projection pending #182 convergence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=12;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="145" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c-api" value="Token-guarded /api/loops&lt;br&gt;List / Get / Create / Update / Delete&lt;br&gt;Strict closed JSON contract&lt;br&gt;System loop cannot be mutated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2B6CB0;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="370" y="145" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c-validate" value="Server validation + role binding&lt;br&gt;Optimistic definition version/hash&lt;br&gt;Typed Trigger and node context policies&lt;br&gt;Only current server-advertised list/read/search assignments&lt;br&gt;No Additional fixed context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="690" y="135" width="315" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c-persist-definition" value="Durable custom definition&lt;br&gt;.agent/loops/definitions/custom&lt;br&gt;Definition tombstones + idempotent mutation receipts&lt;br&gt;Update/Delete rejected while that loop has a nonterminal run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1060" y="145" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c-projection" value="Visual contract&lt;br&gt;Trigger, Exit, connectors, and layout are system projections&lt;br&gt;Persisted contract is ordered, not arbitrary topology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="1450" y="145" width="320" height="105" as="geometry" />
        </mxCell>

        <mxCell id="c-invocation-label" value="INVOCATION + ADMISSION" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#2B6CB0" vertex="1" parent="c1">
          <mxGeometry x="50" y="305" width="260" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c-invoke" value="SignalR InvokeLoop&lt;br&gt;Saved loop id + expected version/hash&lt;br&gt;Idempotent operation id&lt;br&gt;Typed prompt source: invocation, preset, or none&lt;br&gt;Optional bounded logical conversation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2B6CB0;fontSize=12;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="345" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c-gate" value="Workspace custom-execution gate acquired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="420" y="350" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c-busy" value="workspace_execution_busy&lt;br&gt;Durable idempotent rejection&lt;br&gt;No queue, run, deadline, context capture, approval rebinding, or provider dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="395" y="500" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c-capture" value="Server captures immutable admission snapshot&lt;br&gt;Exact source path/content/hash/order&lt;br&gt;Provenance + trust + truncation/omission&lt;br&gt;Role files and bounded logical conversation&lt;br&gt;Pending receipt binds stable conversation + content-only context hash before admission&lt;br&gt;Pre-dispatch terminal binding records exact no-dispatch intent and cannot upgrade&lt;br&gt;Captured binding may terminalize if definition disappears during admission&lt;br&gt;Provider-thread history is never product context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="700" y="340" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c-admit" value="Admission retains exact definition, authority profile, contextual role, loop publication, grant, provider/model, surface, trigger, context, and non-widened capability proof&lt;br&gt;Current role/catalog narrowing must not reject or widen silently&lt;br&gt;Persist run + admission audit + completion marker + invocation receipt before dispatch&lt;br&gt;Pre-#235 canonical artifacts lack the complete proof and are nondispatchable; no fallback reader upgrades them&lt;br&gt;Web persists its prompt-free dispatched operation identity before SignalR send and rolls it back only on a proved pre-dispatch failure&lt;br&gt;After ambiguous connection loss, Web polls the exact durable receipt for a bounded ten seconds without replacing or clearing a newer user selection: Pending / Admitted(run id) / Rejected / Unavailable / Unknown&lt;br&gt;Unknown, receipt-unavailable, and previously dispatched host-unavailable retries retain their runtime-bound operation id in a workspace-scoped, prompt-free cross-tab locked registry that fails closed and caps reservations before persistence; receipts naming admitted or audit-unavailable runs require exact live-run or tombstone evidence before release&lt;br&gt;Receipt quota pressure may prune only completed receipts beyond the 30-day replay boundary&lt;br&gt;Pending/newer receipts survive; exact batch journal + cross-process owner + intent/outcome audit&lt;br&gt;Unresolved audit warnings remain durable; changed/unexplained missing candidates conflict-audit without attribution; recognizable stale atomic temps recover under lock&lt;br&gt;Malformed artifacts fail closed and audit/corruption failures remain distinct from quota exhaustion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1100" y="305" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c-running" value="Admitted -&gt; Running&lt;br&gt;Start audit succeeds before ordered dispatch&lt;br&gt;30-minute accumulated-running deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D8FD;strokeColor=#6B46C1;fontSize=12;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="1530" y="365" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c-execution-label" value="LEGACY ORDERED + CANONICAL FRONTIER EXECUTION" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#2C7A7B" vertex="1" parent="c1">
          <mxGeometry x="50" y="630" width="220" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c-next-step" value="Another deterministic Ready activation?&lt;br&gt;Inference / Transform / Validate / Condition / Join&lt;br&gt;Concurrency ceiling = 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="70" y="680" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-context" value="Resolve this activation's exact inputs&lt;br&gt;Inference resolves governed context; Transform / Validate / Condition resolve only graph-declared typed data from one causal producer; Join resolves exact predecessor arrivals&lt;br&gt;Harness governance is always retained&lt;br&gt;Effective tools = admitted maximum ∩ current role ceiling ∩ implemented catalog&lt;br&gt;Selected context/data sources remain typed and inspectable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2B6CB0;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="350" y="670" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="c-started" value="Persist Ready -&amp;gt; Running plus exact Started event atomically before execution&lt;br&gt;Retain resolved context references or typed binding identities in canonical evidence&lt;br&gt;Retain exact admitted profile / role / loop / grant / capability proof&lt;br&gt;Attempt-start audit must succeed; fresh authority is decided only at each guarded effect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="760" y="680" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c-provider" value="Execute the exact admitted descriptor&lt;br&gt;Inference: exact capability-backed profile pin + typed routing/privacy/budget admission; fresh profile/configuration/adapter/data/authority revalidation; maximum usage reservation before transport; fresh client resolved only from the admitted primary&lt;br&gt;Fallback pins are retained as eligibility evidence only; #350 owns selection and no fallback executes here&lt;br&gt;Run-scoped ToolBroker; List / Read / Search remain read-only callbacks with fresh authority&lt;br&gt;Action: exact catalog pin + workspace.append/write/delete.v1 semantic input -&gt; server-derived target/precondition/before evidence -&gt; durable #338 intent + fresh authority -&gt; single-use native dispatch boundary&lt;br&gt;Transform / Validate: closed nine-operator typed evaluator. Condition: exact Boolean/text decision. Join: All / Any / Selected arrival policy. These nodes receive no effect port.&lt;br&gt;Durable MaxTargetCount counts distinct effect targets once per admitted run across generations, nodes, attempts, and retries&lt;br&gt;Deny/review/unavailable/ambiguous evidence invokes no transport or actuator; reserve exact request/outcome/effect/workspace evidence capacity before execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1130" y="650" width="370" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c-outcome" value="Retain exact bounded outcome before dependent work&lt;br&gt;Inference retains authority / permission / approval / actuator evidence, complete tool response chunks, bounded model output, and the exact admitted model-profile/configuration pin&lt;br&gt;Append-only usage evidence distinguishes authoritative dimensions from unavailable ones; exact reconciliation counts once, never estimates missing values or converts currency, and keeps ambiguous reservations visible for attention. Full bounded segments rotate to immutable authenticated hash-linked archives so retained history cannot exhaust future runs.&lt;br&gt;Workspace Action retains content-free after evidence; delete also retains a value-free tombstone and private recoverable quarantine payload. Replays reuse the exact #338 generation and never repeat mutation.&lt;br&gt;Transform retains canonical typed outputs; Validate retains Boolean observations; Condition retains True / False plus exact selected and skipped edges; Join retains exact arrivals&lt;br&gt;Restart authenticates and reuses committed evidence without reevaluation or repinning. Missing conclusive post-boundary evidence parks for reconciliation and cannot redispatch.&lt;br&gt;Context-out may retain inference output and/or publish through a fresh exact-reference authority decision and one-shot append callback&lt;br&gt;No automatic .agent/MEMORY.md or durable agent-memory writeback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1570" y="650" width="390" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c-checkpoint" value="Persist Ready -&amp;gt; Running before dispatch&lt;br&gt;Retain exact outcome before atomic frontier completion, branch pruning, join-arrival update, and stable next-ready selection&lt;br&gt;Frontier retains activation / plan / visit / cycle coordinates and skipped status; explicit iteration + duration bounds gate loop-back&lt;br&gt;Keep the step index only as a checked projection / isolated legacy cursor; uncertain or malformed restart evidence fails closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1585" y="865" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c-exit-gate" value="Continuation enabled and repeat ceiling remains?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="65" y="895" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-deterministic-exit" value="Deterministic Exit Complete&lt;br&gt;No Exit model call when continuation is off or ceiling is exhausted&lt;br&gt;Apply Exit context-out to the final iteration result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="50" y="1080" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-exit-call" value="Tool-less Exit model attempt&lt;br&gt;Resolve Exit's own inherited/custom context&lt;br&gt;Persist exact Started/context/authority evidence&lt;br&gt;Return only Complete or Repeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="420" y="900" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c-exit-decision" value="Recognized trimmed Exit token?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="820" y="895" width="210" height="135" as="geometry" />
        </mxCell>
        <mxCell id="c-exit-complete" value="Complete&lt;br&gt;Publish/retain the iteration result according to Exit context-out&lt;br&gt;Commit Exit checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1110" y="865" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c-repeat" value="Repeat&lt;br&gt;Ceiling permits exactly this accepted request&lt;br&gt;Increment iteration, return to first step&lt;br&gt;Previous result is selectable only when Exit retained it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="1090" y="1030" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-needs-review" value="Invalid or uncertain Exit outcome&lt;br&gt;NeedsReview&lt;br&gt;No repeat starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontSize=12" vertex="1" parent="c1">
          <mxGeometry x="805" y="1080" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-terminal" value="Terminal durable run&lt;br&gt;Completed / Failed / Cancelled / NeedsReview&lt;br&gt;FirstBoundRunCompletion claims only successful terminal persistence after any selected publication succeeds&lt;br&gt;Failed / paused / cancelled / publication-failed runs do not consume; a completed claim closes later bound runs and effects&lt;br&gt;Final output and failure state remain inspectable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="1550" y="1040" width="310" height="145" as="geometry" />
        </mxCell>

        <mxCell id="c-lifecycle" value="Lifecycle controls&lt;br&gt;REST Pause/Cancel; SignalR Resume binds an approval owner&lt;br&gt;PauseRequested lets the open attempt finish, then enters Paused only at a proved checkpoint&lt;br&gt;Cancel forbids later dispatch; same-process or cross-process requests route through the generation-scoped, capability-authenticated, current-user-only workspace-host IPC broker to the registered provider attempt or conversation publication&lt;br&gt;Caller/deadline cancellation remains a separate competing source; provider interruption is confirmed only when the routed source won&lt;br&gt;Receipt says confirmed provider interruption, signal delivered without confirmation, no active operation, or unavailable delivery; owner exit/routing timeout stays pending for retry&lt;br&gt;Pending Pause/Cancel/Resume receipts hold a cross-process execution lease and durable owner generation; live-owner retries fail closed, while an explicit retry may re-drive only after lease reacquisition proves orphaning&lt;br&gt;Completed control receipts keep 30-day exact replay; quota pressure runs one governed compact-proof cleanup and retries admission once only after commit&lt;br&gt;Stale cleanup ownership recovers after its bounded window; owner locks and recognized atomic temps are reclaimed under the shared mutation lease; raw/proof contradictions fail closed&lt;br&gt;Explicit Resume is allowed only from Paused&lt;br&gt;Pre-ROLE manifests are unsupported development artifacts: recovery does not mutate or audit them, dispatch is forbidden, and cleanup is required&lt;br&gt;One nonterminal run per loop; one actively executing custom loop per workspace; no hidden queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B46C1;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="1270" width="600" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c-recovery" value="Restart recovery under exclusive custom-loop ownership gate shared with Pause; governed recursive workspace search omits and reports the internal host-lock artifact&lt;br&gt;Never dispatches automatically&lt;br&gt;A retained runtime may reacquire hosting after host contention, then verifies the exact durable conversation identity and reconciles only a transcript extension before dispatch&lt;br&gt;Recovery integrity failure disables automatic reacquisition&lt;br&gt;Conversation replacement/divergence/read failure preserves local chat and releases hosting&lt;br&gt;Admitted or clean interrupted work -&gt; Paused&lt;br&gt;Open attempt or incomplete admission integrity -&gt; NeedsReview&lt;br&gt;Safe CancelRequested -&gt; Cancelled&lt;br&gt;Explicit Resume is required after a safe park" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#C05621;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="710" y="1270" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-approvals" value="Web approval ownership&lt;br&gt;Invocation/Resume connection owns its requests&lt;br&gt;Five-minute server timeout&lt;br&gt;Owner disconnect or unavailable owner denies fail-closed&lt;br&gt;Another connection cannot decide or revive the request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="1290" y="1270" width="430" height="170" as="geometry" />
        </mxCell>

        <mxCell id="c-inspection" value="Runs + evidence inspection&lt;br&gt;Immutable creation-order cursors advance through a crash-repairable lightweight metadata index instead of reparsing every retained trace; summaries are hash-bound to canonical artifacts and post-commit maintenance leaves repair markers on interruption&lt;br&gt;The selected loop is fetched through its exact loop-id filter alongside workspace discovery; loop-scoped cursors load older live traces and tombstones without dropping selection, including direct replacement by a committed deletion tombstone&lt;br&gt;A selected active run uses a cached exact-ID monitor and complete-summary plus artifact-hash ETag with standard conditional semantics; only 304 retains full evidence, every changed validator reloads it, and validators commit after successful refresh; unchanged approval waits avoid trace/directory rescans; watcher errors recreate the watcher and require complete validation before cache reuse; scheduled and in-flight endpoint failures use backoff-bounded full reads; only misses uninterrupted by a successful full read clear stale state&lt;br&gt;Monitoring survives reload/reconnect; deleted definitions remain archived history and trace tombstones remain selectable&lt;br&gt;Canonical compact envelope stores exact UTF-8 content once and references context/authority/tool-request tables; reservations retain admitted authority while governance/outcomes retain refreshed pre-actuation authority&lt;br&gt;Maximum bounded proof includes 30 distinct refreshed authorities plus visible 31st over-limit denial: 15,296,441 bytes; 432,199 below 15 MiB target and 1,480,775 below 16 MiB cap; terminal warning and one exact repeated-request integrity slot remain reserved&lt;br&gt;Per-attempt provider/model/profile/configuration pin, context policy/sources, authority/tool evidence, outputs, checkpoints, lifecycle/failure, artifact hash/size, and quota&lt;br&gt;Authenticated usage projects each attempt plus compatible node-series and run aggregates; authoritative and unavailable dimensions remain distinct, outstanding or unknown reservations remain visible, unlike currencies are never converted, and provider-private reasoning, payloads, credentials, executable paths, and endpoints are not exposed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2B6CB0;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="1530" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-deletion" value="Explicit sensitive-trace deletion&lt;br&gt;Terminal runs only + expected current trace hash + idempotent operation id&lt;br&gt;Cross-process receipt reservation before intent audit; overlap observes one pending owner&lt;br&gt;Each post-intent deletion/rejection has one bounded outcome-audit owner; failure/interruption leaves a durable warning&lt;br&gt;Replace content with bounded audited tombstone; deletion is irreversible&lt;br&gt;Separate visible tombstone/receipt limits; receipt capacity reserves terminal deletion headroom&lt;br&gt;Exact receipts are never silently pruned or compacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="650" y="1530" width="520" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c-coexistence" value="Default-conversation coexistence&lt;br&gt;Ordinary chat remains DefaultConversationLoopRunner + AgentRuntime.RunTurnAsync&lt;br&gt;Custom loops use a separate ordered facade, canonical run store, gate, fresh attempt transports, and run-scoped governance&lt;br&gt;Scheduled admission reaches the atomic one-nonterminal-run boundary before the provider lease; provider transport remains lease-fenced&lt;br&gt;Shared logical conversation state participates only when Trigger admits it or context-out publishes to it&lt;br&gt;Canonical schedules and wake work expose an explicit local background-runtime lifetime with durable single-host ownership; Web, CLI, chat, and the default conversation runtime do not host it automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="1230" y="1510" width="710" height="185" as="geometry" />
        </mxCell>
        <!-- Pre-posture canonical-status snapshot retained as reconciliation history.
        <mxCell id="c-maintenance" value="Canonical execution status (#326 / #311 / #235 / #312 / #334 / #313 / #335 / #438 / #336 / #314)&lt;br&gt;One schema-1 lifecycle, admission snapshot, dispatcher, run artifact, and identity/hash-bound frontier remain authoritative. Linear Inference and nine deterministic Transform/Validate operators remain supported.&lt;br&gt;#313 ships exact Boolean, text, and closed model-decision Conditions; All, Any, and Selected Joins; explicit iteration/time-bounded loop-back; and stable static-ordinal multiple-ready selection with at most one Running activation. Branch decisions, selected/skipped edges and activations, join arrivals, activation/visit/cycle coordinates, statuses, and one causal typed producer are durable before dependent work. Startup exposes that frontier read-only and composes the authoritative Application catalog without redefining it.&lt;br&gt;#335 adds exact revision-pinned Once, FixedInterval, Daily, and Weekly schedule definitions; explicit timezone/DST, misfire, catch-up, and overlap policy; optimistic crash-safe occurrence state; and one-shot evaluation through durable queue delivery into the canonical frontier. Dispatch requires one exact finalized Queued/Replayed occurrence from the authenticated schedule store and binds its schedule ID, definition revision/hash, occurrence, delivery/deduplication identities, payload, target, scope, and complete recomputed envelope hash. The exact schedule-trigger origin survives restart; forged, swapped, or time-confused delivery fails before provider transport.&lt;br&gt;#438 binds schedule/revision/occurrence/delivery/target/overlap/pre-queue evidence into one authenticated directive and rechecks it under the run mutation lease. The atomic one-nonterminal-run decision creates one run or retains Skip, the single DeferOne slot/suppression, or serialized Allow evidence before provider dispatch. Provider-free terminal detail compacts oldest-first into an authenticated retirement watermark while active deferred/serialized evidence and RunCreated proof remain durable; a Prepared queue-commit crash becomes ambiguous attention.&lt;br&gt;#336 adds an explicitly started and drained local Startup background-runtime lifetime over schedule, trigger-worker, sleeping-checkpoint, wake, and reconciliation operations. Independent bounded work-family pages, trusted-time admission, durable ownership, and drain-before-release shutdown do not imply distributed coordination or implicit Web/CLI/chat hosting. Checkpoint publication reserves the maximum three-step wake chain and generation-width growth before releasing execution. Heartbeat detail rotates into one authenticated owner-bound retirement summary preserving the latest lease, initial-acquisition replay, and handoff proof; Unix exact-identity cleanup tombstones are reused instead of consuming the interrupted-artifact budget. Prepared and ambiguous wakes wait for trusted chronology, and coordinator response loss is accepted only after exact-head readback.&lt;br&gt;#314 executes exact-UTC timestamp and authenticated-event Wait nodes. It parks the running activation before publishing an immutable checkpoint, binds condition, route, frontier, publication, wake, and continuation evidence, uses trusted time or an injected event authenticator, resolves fresh current authority before continuing, and repairs unpublished parks or committed-but-incomplete continuations after restart without recomputing time or duplicating completion. The Startup host stays inert until its explicit activation boundary; substituted, ambiguous, corrupt, unavailable, or stale evidence fails closed.&lt;br&gt;#235 still gates provider transport, tool intake, post-approval List/Read/Search actuation, and conversation append with exact fresh authority; MaxTargetCount remains non-renewable and FirstBoundRunCompletion success-only.&lt;br&gt;Action/general effects, Human Review/Input, Child Loop, generalized retry/backoff/failure policy, later Web/CLI graph surfaces, unified lifecycle controls, and default-runtime convergence are not claimed. The Web builder and human-legacy cursor stay isolated; no migration, compatibility inference, mutating workspace command, distributed coordinator, or alternate lifecycle, authority, catalog, or frontier store is introduced." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#C05621;fontSize=12;dashed=1" vertex="1" parent="c1">
        <mxCell id="c-maintenance" value="Canonical execution status (#326 / #311 / #235 / #312 / #334 / #313 / #335 / #438 / #336 / #314)&lt;br&gt;One schema-1 lifecycle, admission snapshot, dispatcher, run artifact, and identity/hash-bound frontier remain authoritative. Linear Inference and nine deterministic Transform/Validate operators remain supported.&lt;br&gt;#313 ships exact Boolean, text, and closed model-decision Conditions; All, Any, and Selected Joins; explicit iteration/time-bounded loop-back; and stable static-ordinal multiple-ready selection with at most one Running activation. Branch decisions, selected/skipped edges and activations, join arrivals, activation/visit/cycle coordinates, statuses, and one causal typed producer are durable before dependent work. Startup exposes that frontier read-only and composes the authoritative Application catalog without redefining it.&lt;br&gt;#335 adds exact revision-pinned Once, FixedInterval, Daily, and Weekly schedule definitions; explicit timezone/DST, misfire, catch-up, and overlap policy; optimistic crash-safe occurrence state; and one-shot evaluation through durable queue delivery into the canonical frontier. Dispatch requires one exact finalized Queued/Replayed occurrence from the authenticated schedule store and binds its schedule ID, definition revision/hash, occurrence, delivery/deduplication identities, payload, target, scope, and complete recomputed envelope hash. The exact schedule-trigger origin survives restart; forged, swapped, or time-confused delivery fails before provider transport.&lt;br&gt;#438 binds schedule/revision/occurrence/delivery/target/overlap/pre-queue evidence into one authenticated directive and rechecks it under the run mutation lease. The atomic one-nonterminal-run decision creates one run or retains Skip, the single DeferOne slot/suppression, or serialized Allow evidence before provider dispatch. Provider-free terminal detail compacts oldest-first into an authenticated retirement watermark while active deferred/serialized evidence and RunCreated proof remain durable; a Prepared queue-commit crash becomes ambiguous attention.&lt;br&gt;#336 adds an explicitly started and drained local Startup background-runtime lifetime over schedule, trigger-worker, sleeping-checkpoint, wake, and reconciliation operations. Independent bounded work-family pages, trusted-time admission, durable ownership, and drain-before-release shutdown do not imply distributed coordination or implicit Web/CLI/chat hosting. Checkpoint publication reserves the maximum three-step wake chain and generation-width growth before releasing execution. Heartbeat detail rotates into one authenticated owner-bound retirement summary preserving the latest lease, initial-acquisition replay, and handoff proof; Unix exact-identity cleanup tombstones are reused instead of consuming the interrupted-artifact budget. Prepared and ambiguous wakes wait for trusted chronology, and coordinator response loss is accepted only after exact-head readback.&lt;br&gt;#314 executes exact-UTC timestamp and authenticated-event Wait nodes. It parks the running activation before publishing an immutable checkpoint, binds condition, route, frontier, publication, wake, and continuation evidence, uses trusted time or an injected event authenticator, resolves fresh current authority before continuing, and repairs unpublished parks or committed-but-incomplete continuations after restart without recomputing time or duplicating completion. Startup exposes explicit authenticated-event delivery through the shared runtime facade, while the background host stays inert until its activation boundary; fully published sleepers are excluded from bounded recovery selection, and substituted, ambiguous, corrupt, unavailable, or stale evidence fails closed.&lt;br&gt;#235 still gates provider transport, tool intake, post-approval List/Read/Search actuation, and conversation append with exact fresh authority; MaxTargetCount remains non-renewable and FirstBoundRunCompletion success-only.&lt;br&gt;Action/general effects, Human Review/Input, Child Loop, generalized retry/backoff/failure policy, later Web/CLI graph surfaces, unified lifecycle controls, and default-runtime convergence are not claimed. The Web builder and human-legacy cursor stay isolated; no migration, compatibility inference, mutating workspace command, distributed coordinator, or alternate lifecycle, authority, catalog, or frontier store is introduced." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#C05621;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="1745" width="1890" height="220" as="geometry" />
        -->
        <mxCell id="c-maintenance" value="Canonical execution status (#326 / #311 / #235 / #312 / #334 / #313 / #335 / #438 / #336 / #314 / #337)&lt;br&gt;One schema-1 lifecycle, admission snapshot, dispatcher, run artifact, and identity/hash-bound frontier remain authoritative. Linear Inference and nine deterministic Transform/Validate operators remain supported.&lt;br&gt;#313 ships exact Boolean, text, and closed model-decision Conditions; All, Any, and Selected Joins; explicit iteration/time-bounded loop-back; and stable static-ordinal multiple-ready selection with at most one Running activation. Branch decisions, selected/skipped edges and activations, join arrivals, activation/visit/cycle coordinates, statuses, and one causal typed producer are durable before dependent work. Startup exposes that frontier read-only and composes the authoritative Application catalog without redefining it.&lt;br&gt;#335 adds exact revision-pinned Once, FixedInterval, Daily, and Weekly schedule definitions; explicit timezone/DST, misfire, catch-up, and overlap policy; optimistic crash-safe occurrence state; and one-shot evaluation through durable queue delivery into the canonical frontier. Dispatch requires one exact finalized Queued/Replayed occurrence from the authenticated schedule store and binds its schedule/definition/occurrence identities plus complete recomputed envelope hash into the run artifact. An exact queue-accepted ResultObserved occurrence awaiting finalization releases worker ownership before intent and retries after finalization; rejected or mismatched pending evidence remains fail-closed. The exact schedule-trigger entry and origin survive restart/replay; forged, swapped, and manual/time-confused delivery fails before governed admission or provider transport. Pending occurrence identity is durable before external evidence, and ambiguous delivery, clock rollback, or timezone drift fails closed without guessed completion.&lt;br&gt;#438 binds schedule/revision/occurrence/delivery/target/overlap/pre-queue evidence into one authenticated execution directive and rechecks it under the canonical run mutation lease. The atomic one-nonterminal-run decision creates one run or durably records Skip, the single DeferOne slot/suppression, or each serialized Allow occurrence before provider dispatch; restart and exact replay preserve the same evidence. Scheduled preparation precedes the broader execution lease while provider transport remains fenced. A terminal queue entry replayed from the Prepared queue-commit crash window becomes ambiguous attention rather than a fabricated successful delivery.&lt;br&gt;#336 adds an explicitly started and drained local Startup background-runtime lifetime over the canonical schedule, trigger-worker, sleeping-checkpoint, wake, and reconciliation operations. A durable single-host lease and ownership epoch, trusted-time fence against the latest durable heartbeat before each admission, independent deterministic work-family pages, truthful truncated-backlog posture, fixed bounded cadence, duplicate backpressure-evidence suppression, and append-only bounded wake evidence support drainable crash/restart continuation without claiming distributed coordination or implicit Web/CLI/chat hosting. Prepared and ambiguous wakes cannot invoke continuation until trusted time catches up with their durable evidence chronology. Actual store backpressure stays distinct from a page-bound backlog. Checkpoint publication posture remains immutable; each wake claim separately retains the fresh current-posture proof, and post-commit coordinator unavailability is reconciled only by an authoritative exact-head readback.&lt;br&gt;#314 now executes exact-UTC timestamp and authenticated-event Wait nodes. It parks the running activation before publishing an immutable checkpoint, binds condition, route, frontier, publication, wake, and continuation evidence, uses trusted TimeProvider time or an injected event authenticator, resolves fresh current authority before continuing, and repairs unpublished parks or committed-but-incomplete continuations after restart without recomputing time or duplicating completion. Startup exposes explicit authenticated-event delivery through the shared runtime facade, while the background host stays inert until its activation boundary; fully published sleepers are excluded from bounded recovery selection, and substituted, ambiguous, corrupt, unavailable, or stale evidence fails closed.&lt;br&gt;#337 exposes one Startup operational facade over the exact queue, schedule, checkpoint/wake, run, coordinator-lease, and worker stores. Queue reads validate under the canonical lock without sweeping or publishing lifecycle state; canonical evidence order and generation-bound opaque cursors never claim coordinator-local fairness rank. Immutable-disabled schedules expose no enable action, causally ambiguous schedule-control restarts require review, and receipt progress is defensively detached. Bounded cursors, full-catalog validation, current lifecycle eligibility, exact optimistic controls, pre-effect authority revalidation, and hash-linked crash-safe receipts preserve the existing subsystem truths without exposing payloads or secrets.&lt;br&gt;#235 still gates provider transport, tool intake, post-approval List/Read/Search actuation, and conversation append with exact fresh authority; MaxTargetCount remains non-renewable and FirstBoundRunCompletion success-only.&lt;br&gt;Action/general effects, Human Review/Input, Child Loop, generalized retry/backoff/failure policy, later Web/CLI graph surfaces, global posture aggregation, and default-runtime convergence are not claimed. The Web builder and human-legacy cursor stay isolated; no migration, compatibility inference, mutating workspace command, distributed coordinator, or alternate lifecycle, authority, catalog, or frontier store is introduced." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#C05621;fontSize=12;dashed=1" vertex="1" parent="c1">
          <mxGeometry x="50" y="1745" width="1890" height="185" as="geometry" />
        </mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B46C1;endArrow=block;endFill=1" edge="1" parent="c1" source="c-web" target="c-api"><mxGeometry relative="1" as="geometry" /></mxCell>
