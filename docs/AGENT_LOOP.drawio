          <mxGeometry x="1040" y="1070" width="205" height="80" as="geometry" />
        </mxCell>
        <mxCell id="codex" value="CodexAppServerInferenceClient&lt;br&gt;ContextBuilder builds turn input + assigned command guidance&lt;br&gt;ToolBridge exposes loop-assigned dynamic commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1240" y="1185" width="285" height="85" as="geometry" />
        </mxCell>
        <mxCell id="process" value="Resolve Codex: explicit path, Desktop, then PATH&lt;br&gt;Probe --version + exact configured model via model/list&lt;br&gt;Start resolved app-server --stdio&lt;br&gt;Send JSON-RPC thread/start + turn/start&lt;br&gt;Read item/agentMessage/delta + turn/completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1240" y="1310" width="285" height="125" as="geometry" />
        </mxCell>
        <mxCell id="exitCode" value="turn/completed status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B7791F;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1265" y="1475" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="Failure / restart path&lt;br&gt;Pre-dispatch: reconcile accepted message and close without provider dispatch&lt;br&gt;Entered provider + no observed outcome: NeedsReview; never auto-repeat&lt;br&gt;Observed output: idempotently repair assistant publication&lt;br&gt;Observed output + completion-audit failure: retain output as NeedsReview; never publish or redispatch&lt;br&gt;Observed terminal provider failure: persist Failed even if completion auditing also fails; no quarantine or review&lt;br&gt;Divergent transcript: preserve content + NeedsReview unless failure is conclusive; retain conflict detail durably&lt;br&gt;Identityless pre-release transcript: exact cleanup path; no migration&lt;br&gt;Active review identity keeps the matching current transcript visible&lt;br&gt;CLI and Web hydrate the same recovered transcript/run truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="950" y="1470" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="success" value="Success path&lt;br&gt;Extract final agentMessage from turn/completed&lt;br&gt;Return LlmInferenceResponse&lt;br&gt;Append llm.inference.complete succeeded if audit log exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1240" y="1610" width="285" height="95" as="geometry" />
        </mxCell>
        <mxCell id="print" value="Durably observe exact assistant output + provider response id&lt;br&gt;Persist assistant publication intent; compare-and-append exactly once&lt;br&gt;Checkpoint durable/runtime transcript synchronization&lt;br&gt;Prepare terminal status, project run, commit terminal checkpoint&lt;br&gt;Release lease; Console/Web project output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="930" y="1630" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="boundaries" value="Current boundaries&lt;br&gt;- Default conversation turns flow through DefaultConversationLoopRunner and AgentRuntime.RunTurnAsync.&lt;br&gt;- Workspace bootstrap treats AGENTS.md + .agent/ROLE.md as contextual role instructions, SOUL.md + PERSONALITY.md as durable agent identity, and CONTEXT.md + MEMORY.md + models.json as lower-authority state; old AGENT.md workspaces require reinitialization.&lt;br&gt;- One file-backed workspace conversation lease serializes live turns and restart reconciliation across runtime instances and processes.&lt;br&gt;- Application owns a schema-v1 intent/outbox/checkpoint protocol under .agent/loops/runs/default-conversation-turns; every turn/run/message/provider attempt/correlation/publication/transition has stable identity and exact append-only evidence.&lt;br&gt;- CLI normally starts fresh and Web normally restores, but either surface preserves and hydrates the same current transcript when incomplete or matching active-review evidence requires recovery.&lt;br&gt;- Before SignalR dispatch, Web retains at most one exact canonical pending message and request id in workspace-scoped local storage under a cross-tab lock; the non-secret scope survives Web process restarts while the bearer token rotates, ambiguous outcomes retain the id, reconciliation never auto-dispatches, and unavailable/corrupt/over-bound state fails closed.&lt;br&gt;- The outcome becomes unknown at the durable callback immediately before the provider turn/start transport write; without an observed terminal outcome restart parks NeedsReview and never redispatches.&lt;br&gt;- Ambiguous transport is quarantined; /review and /review resolve &lt;turn-id&gt; provide explicit inspection and abandonment without replay or publication.&lt;br&gt;- Identity-bearing exact-prefix publication repairs proved user/assistant appends; conversation identity/version/order conflicts preserve existing content and park NeedsReview.&lt;br&gt;- The default definition remains a system-locked graph loaded from .agent/loops/definitions when present.&lt;br&gt;- Default-turn run records cover started/completed/failed/cancelled/needs-review outcomes and are repairable projections of the canonical turn checkpoint.&lt;br&gt;- Loop CapabilityIds filter workspace commands before ToolPermissionService + ToolBroker enforce path policy, approval, execution, full-response retention, and audit.&lt;br&gt;- Correlations are bounded before actuation; post-actuation retention, observation, and execution audit use a bounded integrity token independent of caller cancellation, and timeout returns the actual operation outcome with an explicit do-not-retry evidence-gap warning.&lt;br&gt;- Complete bounded tool responses are chunked under .agent/logs/tool-responses before 64,000-character model formatting; references/hashes remain visible and inspection requires approval, while full-quota evidence inspection explicitly reports unavailable self-retention.&lt;br&gt;- Custom authoring/execution uses a separate Startup facade and ordered runtime shown on the Custom Loop MVP page.&lt;br&gt;- Both paths share AgentRuntime and logical ConversationRuntimeState only for explicitly captured or published product context.&lt;br&gt;- Each custom attempt owns a fresh provider transport and run-scoped ToolBroker; the custom execution gate does not globally serialize ordinary chat." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;fontSize=12;dashed=1" vertex="1" parent="1">
          <mxGeometry x="70" y="870" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="maintenance" value="Governed-loop foundation status (#326, #333, #310, #233, #299, #235, #302, #303, #338, #340)&lt;br&gt;Schema-1 lifecycle, frontier, effect, projection, immutable revision, canonical graph artifact, revision-pinned authority-grant, admission, execution-authority, durable Human Input, and exact workspace-action contracts now exist.&lt;br&gt;Graph authoring composes normalized payloads over the generic revision lifecycle with separate executable, layout, and full-artifact hashes; authenticated bounded persistence retains exact authoring intent, validation evidence, immutable payload history, and append-only lifecycle evidence for deterministic retry.&lt;br&gt;The revision store retains immutable drafts, exact validated publications, disable/archive posture, rollback successors, and append-only evidence; exact pins never follow replacement.&lt;br&gt;The authenticated authority ledger retains explicit create/narrow/suspend/replace/revoke/expire grant successors bound to exact profile, role, and loop revisions; current actor, dependency, time, and ceiling evidence is revalidated and any failed posture projects empty effective authority.&lt;br&gt;Governed admission retains the exact profile, role, loop publication, grant, and non-widened capability proof under one reentrant workspace authority transaction. The same transaction protects fresh exact-reference decisions and append-only evidence before provider transport, tool intake, workspace actuator dispatch, and conversation append, so concurrent narrowing cannot widen the guarded commit.&lt;br&gt;The authenticated schema-1 usage ledger counts distinct target fingerprints against one admitted run across generations, nodes, attempts, and retries. Exact targets deduplicate; workspace intake and actuation share the server-resolved-path fingerprint, while conversation publication reserves its exact admitted target.&lt;br&gt;FirstBoundRunCompletion is claimed only around successful terminal persistence after any selected publication succeeds. Failed, paused, cancelled, and publication-failed runs do not consume it; interrupted pending claims admit only the exact same completion retry, and a completed claim closes later bound runs and effects.&lt;br&gt;Deny, review, unavailable, ambiguous, substituted, or corrupt authority evidence permits no operation. Pre-#235 canonical artifacts lack the complete proof and remain nondispatchable; no compatibility reader upgrades them.&lt;br&gt;The authenticated Human Input store retains bounded immutable request versions and exact-replay evidence for Create, Remind, Reroute, Amend, Reject, Cancel, Expire, and atomic Supersede, plus private response artifacts and append-only Submit, Withdraw, and Select evidence in one globally ordered operation timeline.&lt;br&gt;Server-owned actor and time evidence gates each new response attempt. First-valid, exact-value quorum, named-role, provenance-preserving merge, and manual-selection policies deterministically select immutable response references without synthesizing content; selection and the terminal Answered request head commit atomically.&lt;br&gt;Responses remain untrusted data and never grant approval, consent, credential access, or effect authority. Exact replay authenticates the same actor, concurrency and corruption fail closed, and values stay out of public evidence and posture.&lt;br&gt;#235 supplies the reusable authority seam consumed by #338's canonical actuator protocol. #340 registers exact append/write/recoverable-delete operations, retains separate content-free before/after/outcome/tombstone evidence, removes direct mutation from IWorkspaceToolExecutor, and dispatches exact admitted Action nodes through the canonical ordered graph runner. Windows existing-file updates atomically replace from the durable stage while retaining and authenticating the displaced file; mismatch or interruption remains explicit reconciliation. Private stage/quarantine artifacts carry restrictive permissions and authenticated attempt-owned markers; bounded cleanup removes only old artifacts whose canonical intent is proved absent while ambiguity remains quarantined. The default-conversation ToolBroker remains mutation-unavailable until it can supply the same complete Action identity; it has no direct fallback. Credential expansion, operator disposition, failure policy, broader actions, and Human Review remain later slices.&lt;br&gt;See docs/GOVERNED_LOOP_EXECUTION_CONTRACT.md. Keep README.md and this source aligned when real behavior changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#C05621;fontSize=12;dashed=1" vertex="1" parent="1">
          <mxGeometry x="70" y="1155" width="520" height="430" as="geometry" />
        </mxCell>
        <mxCell id="canonical-effect-attempt" value="Canonical actuator effect protocol (#338 / #340)&lt;br&gt;Resolve one exact admitted capability pin to one current server registration. Workspace registers workspace.append.v1, workspace.write.v1, and recoverable workspace.delete.v1.&lt;br&gt;Closed schema-1 input names one normalized relative regular-file target, one optimistic precondition, and bounded UTF-8/value-free-reference segments. Server preparation retains exact no-follow root/ancestor/parent/target identity and value-free before evidence before intent.&lt;br&gt;Persist IntentPrepared, append fresh exact-match authority, then persist DispatchBoundaryReached before the single-use native commit callback. The capability-artifact mutation boundary remains nested defense.&lt;br&gt;Expected-absent uses atomic no-replace. Existing Unix append/write uses exchange plus displaced-identity verification and owner/group/mode/access-ACL preservation. Windows retains no-delete-share workspace and private-stage ancestor fences, then uses ReplaceFileW to atomically publish the durable stage and retain the actual displaced target under an authenticated private backup name; ReplaceFileW native metadata handling plus retained-handle readback preserves exact owner, primary group, DACL, and DACL-protection metadata. A changed backup witness or interrupted post-boundary state retains all artifacts for reconciliation. NTFS identity support and ReplaceFileW are required; any unsupported volume or native failure fails closed. Delete atomically moves the retained target into private quarantine.&lt;br&gt;Restrictive staging/quarantine roots and schema-1 attempt-owned markers authenticate bounded recovery artifacts. Cleanup requires an old marker, matching before evidence, unchanged target, and proved absence from the canonical attempt store; uncertainty and any exact original quarantine payload remain untouched. Delete retains same-filesystem quarantine payload plus immutable 30-day tombstone. Before/after/outcome/tombstone evidence contains fingerprints, hashes, byte/version counts, and references, never raw content, credentials, or absolute paths.&lt;br&gt;Conclusive outcomes commit; proved pre-boundary stops become DispatchNotStarted; every post-boundary ambiguity becomes ReconciliationRequired and is never automatically redispatched. Probe posture is only proved-not-started, proved-observed, or indeterminate.&lt;br&gt;IWorkspaceToolExecutor is read-only. The ordered graph runner dispatches the exact admitted Action projection and reuses retained result evidence across restart. Default-chat mutation remains unavailable without the same complete Action identity and never falls back to a direct filesystem path. Human Review, operator disposition, retry, repair, compensation, escalation, and fallback remain later slices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#2C7A7B;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="610" y="1155" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="canonical-credential-lease" value="Canonical single-use credential lease (#219)&lt;br&gt;Reference + exact binding -&gt; reserved registry evidence/operation capacity -&gt; current admission/authority/grant/delegation/effect/profile/capability + registry/lifecycle/consent/provider revalidation under shared authority and reference fences -&gt; at-most-60-second nonrenewable lease.&lt;br&gt;Persist IntentPrepared and Authorized, reserve every terminal attempt/evidence successor, then commit RedemptionBoundaryReached before one synchronous provider-owned callback.&lt;br&gt;Pre-boundary stop = NotRedeemed. Post-boundary crash/cancellation/unknown completion = RedemptionAmbiguous; never replay material use.&lt;br&gt;Retain only generation-unique, value-free lease/effect/authority/profile/capability/actor and safe target-fingerprint evidence with bounded redaction summary; exact reservations survive later lifecycle changes and are consumed once.&lt;br&gt;Startup composes an explicit trusted local provider map with no fallback. Web/CLI/chat/model tools, actuator injection (#220), and concrete action adapters (#340/#341) remain unimplemented." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="610" y="1395" width="560" height="190" as="geometry" />
        </mxCell>
