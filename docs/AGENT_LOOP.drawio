        <mxCell id="addUser" value="DefaultConversationLoopRunner.RunTurnAsync(input)&lt;br&gt;Acquire cross-process workspace conversation lease&lt;br&gt;Admit schema-v1 turn artifact with stable run/message/attempt/publication ids + exact base transcript&lt;br&gt;Checkpoint Started run, user acceptance, publication intent, idempotent transcript append&lt;br&gt;Replace runtime projection only from the canonical durable transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="930" y="920" width="245" height="90" as="geometry" />
        </mxCell>
