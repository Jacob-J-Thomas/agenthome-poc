          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;endArrow=block;endFill=1" edge="1" parent="1" source="addUser" target="generate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;endArrow=block;endFill=1" edge="1" parent="1" source="generate" target="surface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="not current default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C53030;endArrow=block;endFill=1" edge="1" parent="1" source="surface" target="unsupported">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="OpenAiCodex" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;endArrow=block;endFill=1" edge="1" parent="1" source="surface" target="codex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;endArrow=block;endFill=1" edge="1" parent="1" source="codex" target="process">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3182CE;endArrow=block;endFill=1" edge="1" parent="1" source="process" target="exitCode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C53030;endArrow=block;endFill=1" edge="1" parent="1" source="exitCode" target="failure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F855A;endArrow=block;endFill=1" edge="1" parent="1" source="exitCode" target="success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F855A;endArrow=block;endFill=1" edge="1" parent="1" source="success" target="print">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="continue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F855A;endArrow=block;endFill=1" edge="1" parent="1" source="print" target="prompt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="1670" />
              <mxPoint x="890" y="828" />
            </Array>
